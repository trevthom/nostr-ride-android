+
+// The page shown when the shell itself broke. Plain and self-contained on purpose: it must work when
+// the screens' own styling or the map did not, and it always offers a reload (the app holds no data
+// that a reload loses: keys and coins are saved on the device as they change).
+export function FatalScreen({ error }) {
+  const message = String(error?.message || error || "Unknown error");
+  return (
+    <div className="nr-frame flex flex-col items-center justify-center gap-3 p-6 bg-white text-center">
+      <p className="font-bold text-lg">NostrRide stopped</p>
+      <p className="text-neutral-600 text-sm break-words max-w-xs">{message}</p>
+      <p className="text-neutral-500 text-xs max-w-xs">Your ecash, and your key if you saved it here, stay on this device.</p>
+      <button
+        type="button"
+        onClick={() => window.location.reload()}
+        className="px-5 py-2.5 rounded-full text-sm font-semibold bg-black text-white"
+      >
+        Reload
+      </button>
+    </div>
+  );
+}
+
+// The whole app, not just one screen (see the note at the top of this file).
+export class RootBoundary extends Component {
+  constructor(props) {
+    super(props);
+    this.state = { error: null };
+  }
+
+  static getDerivedStateFromError(error) {
+    return { error };
+  }
+
+  componentDidCatch(error, info) {
+    console.error("App error:", error, info);
+  }
+
+  render() {
+    if (this.state.error) return <FatalScreen error={this.state.error} />;
+    return this.props.children;
+  }
+}
