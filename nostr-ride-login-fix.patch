+// The heartbeat in a plain browser, and in a shell built before the plugin existed: nothing to start,
+// no hook installed, and no call to the native side.
+import assert from "node:assert/strict";
+
+const calls = [];
+globalThis.window = globalThis;
+// No bridge at import time: this is a browser. @capacitor/core records the platform as "web".
+globalThis.Capacitor = { nativePromise: (...args) => { calls.push(args); return Promise.resolve(); } };
+
+const H = await import("../src/lib/heartbeat.js");
+
+assert.equal(globalThis.__nostrRideBeat, undefined, "nothing installed yet");
+const stop = H.startHeartbeat(() => { throw new Error("must never be called"); });
+assert.equal(typeof stop, "function");
+stop();
+stop(); // idempotent
+assert.equal(globalThis.__nostrRideBeat, undefined, "no hook in a browser");
+
+// Now an Android bridge appears, but this page never registered the heartbeat plugin (an older APK):
+// still nothing to start, and still no hook.
+globalThis.androidBridge = {};
+const stopOld = H.startHeartbeat(() => { throw new Error("must never be called"); });
+stopOld();
+assert.equal(globalThis.__nostrRideBeat, undefined, "an older shell has no timer to give");
+await new Promise((r) => setTimeout(r, 5));
+assert.equal(calls.length, 0, "the native side is never called");
+
+console.log("heartbeat web checks passed");
+process.exit(0);
