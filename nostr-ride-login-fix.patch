diff --git a/test/keystore.test.mjs b/test/keystore.test.mjs
new file mode 100644
index 0000000..1e174c7
--- /dev/null
+++ b/test/keystore.test.mjs
@@ -0,0 +1,41 @@
+// "Remember me": the one key saved on this device (nostr/keystore.js). A saved record is read before the
+// first screen is drawn, so an incomplete one must be ignored, never handed to the unlock screen (which
+// needs the public key, and used to crash the whole app into a blank page without it).
+import assert from "node:assert/strict";
+
+const mem = new Map();
+globalThis.localStorage = {
+  getItem: (k) => (mem.has(k) ? mem.get(k) : null),
+  setItem: (k, v) => void mem.set(k, String(v)),
+  removeItem: (k) => void mem.delete(k),
+};
+const R = new URL("../src", import.meta.url).pathname;
+const K = await import(`${R}/nostr/keystore.js`);
+
+const KEY = "nostrride_key";
+const pk = "ab".repeat(32);
+
+// Nothing saved: the sign-in form is shown.
+assert.equal(K.getSavedKey(), null, "no record, nothing to unlock");
+
+// A complete record is what the unlock screen needs.
+mem.set(KEY, JSON.stringify({ ncryptsec: "ncryptsec1test", pubkey: pk, name: "Ana" }));
+assert.deepEqual(K.getSavedKey(), { ncryptsec: "ncryptsec1test", pubkey: pk, name: "Ana" });
+
+// A record without a public key (an older app's shape, or a half-written one) is ignored.
+mem.set(KEY, JSON.stringify({ ncryptsec: "ncryptsec1test" }));
+assert.equal(K.getSavedKey(), null, "no public key: nothing the unlock screen could draw");
+
+// Nor a malformed public key, nor a ciphertext that is not text.
+mem.set(KEY, JSON.stringify({ ncryptsec: "ncryptsec1test", pubkey: "nope" }));
+assert.equal(K.getSavedKey(), null);
+mem.set(KEY, JSON.stringify({ ncryptsec: 42, pubkey: pk }));
+assert.equal(K.getSavedKey(), null);
+
+// The public key is normalized; a name that is not text is dropped instead of reaching the screen.
+mem.set(KEY, JSON.stringify({ ncryptsec: "ncryptsec1test", pubkey: pk.toUpperCase(), name: { not: "text" } }));
+assert.deepEqual(K.getSavedKey(), { ncryptsec: "ncryptsec1test", pubkey: pk, name: "" });
+
+// Corrupt JSON is not fatal either.
+mem.set(KEY, "{not json");
+assert.equal(K.getSavedKey(), null);
diff --git a/test/native-web.test.mjs b/test/native-web.test.mjs
new file mode 100644
index 0000000..129e953
--- /dev/null
+++ b/test/native-web.test.mjs
@@ -0,0 +1,23 @@
+// A plain browser must never call the native plugin, and a shell built without it (an older APK)
+// must say so instead of crashing. No bridge at import time = a browser; the plugin is not available
+// even once an Android bridge appears later, because this page never registered one.
+import assert from "node:assert/strict";
+
+const N = await import("../src/lib/nativeGeo.js");
+
+assert.equal(N.isNative(), false, "no shell: the app uses lib/useGeolocation.js");
+assert.equal(N.isIos(), false);
+const webErrors = [];
+N.startNativeWatch(() => {}, (e) => webErrors.push(e));
+assert.equal(webErrors[0].code, 2, "a clear error, not a crash");
+assert.equal(webErrors[0].message, "Background location is not available in this app.");
+
+// Now pretend to be an Android shell that was built WITHOUT @capacitor-community/background-geolocation:
+// the platform is Android, but this plugin has no header (no native methods) for it.
+globalThis.androidBridge = {};
+assert.equal(N.isNative(), true, "the platform is read live");
+const oldShellErrors = [];
+N.startNativeWatch(() => {}, (e) => oldShellErrors.push(e));
+assert.equal(oldShellErrors[0].code, 2, "an older APK says the location plugin is missing");
+console.log("native web checks passed");
+process.exit(0);
